<Window x:Class="SlimViews.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About SlimViewer" 
        Height="420" Width="520"
        WindowStartupLocation="CenterOwner" 
        ResizeMode="NoResize"
        Background="#FAFAFA">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="*" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Application Header Card -->
        <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4" Padding="14,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- App Icon -->
                <TextBlock Grid.Column="0" Text="🖼️" FontSize="32" VerticalAlignment="Center" Margin="0,0,14,0" />

                <!-- Title & Version Info -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="SlimViewer" FontSize="20" FontWeight="Bold" Foreground="#222222" />
                    <TextBlock Text="Version 1.0.0 | Created by Peter Geinitz (Wayfarer)" 
                               FontSize="12" Foreground="#666666" Margin="0,2,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- License Terms Card -->
        <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4" Padding="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="8" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal">
                    <TextBlock Text="📜" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBlock Text="License Agreement" FontWeight="SemiBold" Foreground="#444444" VerticalAlignment="Center" />
                </StackPanel>

                <TextBox Grid.Row="2" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" 
                         Background="#F9F9F9" Foreground="#333333" BorderBrush="#E0E0E0" Padding="8"
                         FontFamily="Consolas" FontSize="11" xml:space="preserve"
                         ToolTip="Software license terms (Apache License, Version 2.0)">Copyright 2024-2026 Peter Geinitz

Licensed under the Apache License, Version 2.0 (the "License");
you may not use this file except in compliance with the License.
You may obtain a copy of the License at

    http://www.apache.org/licenses/LICENSE-2.0

Unless required by applicable law or agreed to in writing, software
distributed under the License is distributed on an "AS IS" BASIS,
WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
See the License for the specific language governing permissions and
limitations under the License.</TextBox>
            </Grid>
        </Border>

        <!-- Footer Action Button -->
        <Button Grid.Row="4" Content="❌ Close" Width="100" Height="30" HorizontalAlignment="Right"
                FontWeight="SemiBold" IsCancel="True" Click="Button_Click"
                ToolTip="Close this window" />
    </Grid>
</Window>