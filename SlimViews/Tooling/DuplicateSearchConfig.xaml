<Window x:Class="SlimViews.Tooling.DuplicateSearchConfig"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Find Duplicate / Similar Images"
        Width="480"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}">
    <StackPanel Margin="16">
        <TextBlock Text="Folders to search" FontWeight="Bold" Margin="0,0,0,6" />
        <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Height="120">
            <ListBox x:Name="FolderListBox" ItemsSource="{Binding Folders}" BorderThickness="0"
                     Background="Transparent"
                     ToolTip="Every selected folder is searched together, as one combined pool - a duplicate spanning two of these folders is still found" />
        </Border>
        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
            <Button Content="➕ Add Folder..." Click="AddFolder_Click" Margin="0,0,6,0" Padding="10,4" />
            <Button Content="➖ Remove Selected" Click="RemoveFolder_Click" Padding="10,4" />
        </StackPanel>

        <CheckBox x:Name="SubfoldersCheckBox" Content="Include subfolders" Margin="0,14,0,0" />

        <Separator Margin="0,14,0,10" />

        <RadioButton x:Name="ExactRadio" Content="Exact duplicates only (byte-for-byte)"
                     GroupName="Mode" IsChecked="True" Checked="ModeChanged" />
        <RadioButton x:Name="SimilarRadio" Content="Similar images (perceptual match)"
                     GroupName="Mode" Margin="0,6,0,0" Checked="ModeChanged" />

        <Grid x:Name="SimilarityPanel" Margin="20,10,0,0" IsEnabled="False">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="50" />
            </Grid.ColumnDefinitions>
            <Slider x:Name="SimilaritySlider" Minimum="1" Maximum="99" Value="80"
                    TickFrequency="1" IsSnapToTickEnabled="True"
                    ValueChanged="SimilaritySlider_ValueChanged" VerticalAlignment="Center"
                    ToolTip="Higher = closer match required" />
            <TextBlock x:Name="SimilarityLabel" Grid.Column="1" Text="80%"
                       VerticalAlignment="Center" HorizontalAlignment="Right" />
        </Grid>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Search" Width="90" IsDefault="True" Click="Search_Click" Margin="0,0,8,0"
                    Padding="10,4" />
            <Button Content="Cancel" Width="90" IsCancel="True" Padding="10,4" />
        </StackPanel>
    </StackPanel>
</Window>