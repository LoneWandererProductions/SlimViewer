<Window x:Class="SlimViews.Tooling.Compare"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:images="clr-namespace:Common.Images;assembly=Common.Images"
        xmlns:gifs="clr-namespace:Imaging.Gifs;assembly=Imaging"
        mc:Ignorable="d"
        Title="Compare Images &amp; Duplicates" 
        Height="800" Width="1050" 
        MinHeight="600" MinWidth="850"
        x:ClassModifier="internal"
        x:Name="RootWindow"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="#141414">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/SlimViewer;component/Themes/Generic.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="460" />
        </Grid.ColumnDefinitions>

        <!-- ================================================================= -->
        <!-- LEFT PANE: LARGE IMAGE PREVIEW                                    -->
        <!-- ================================================================= -->
        <Border Grid.Column="0" Background="#1E1E1E" BorderBrush="#333333" BorderThickness="1" Margin="0,0,10,0" CornerRadius="6">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Preview Header -->
                <Border Grid.Row="0" Background="#252526" BorderBrush="#333333" BorderThickness="0,0,0,1" Padding="10,8" CornerRadius="5,5,0,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="👁️" FontSize="14" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="Selected Image Preview" FontWeight="SemiBold" Foreground="#CCCCCC" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <!-- Image / GIF Display -->
                <gifs:ImageGif Grid.Row="1" 
                               GifSource="{Binding SelectedImagePath}"
                               AutoStart="True"
                               Stretch="Uniform"
                               Margin="12"
                               ToolTip="Active preview image" />
            </Grid>
        </Border>

        <!-- ================================================================= -->
        <!-- RIGHT PANE: DETAILS & DUPLICATE GROUPS                            -->
        <!-- ================================================================= -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 1. Top File Details Card -->
            <Border Grid.Row="0" Background="#252526" BorderBrush="#383838" BorderThickness="1" Padding="12" CornerRadius="6" Margin="0,0,0,10">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="📊" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="ACTIVE IMAGE DETAILS" Foreground="#AAAAAA" FontSize="11" FontWeight="Bold" />
                    </StackPanel>
                    <TextBlock Text="{Binding CurrentSelectedImageInfo}"
                               Foreground="#FFFFFF"
                               TextWrapping="Wrap"
                               FontFamily="Segoe UI Semibold"
                               FontSize="12"
                               LineHeight="18"
                               ToolTip="File path, dimensions, and size information" />
                </StackPanel>
            </Border>

            <!-- 2. Scrollable Duplicate Groups List -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding DuplicateGroups}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <!-- Group Card -->
                            <Border Background="#252526" BorderBrush="#383838" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,8,12">
                                <StackPanel>

                                    <!-- Group Header Toolbar -->
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="👯 Duplicate Group" FontWeight="Bold" Foreground="#E0E0E0" VerticalAlignment="Center" />
                                        </StackPanel>

                                        <Button Grid.Column="1" 
                                                Content="🗑️ Delete Entire Group" 
                                                Command="{Binding DeleteAllCommand}" 
                                                Padding="8,3" Height="26"
                                                Background="#3A1C1C" Foreground="#FF6B6B" BorderBrush="#5E2A2A"
                                                ToolTip="Delete all images in this comparison group from disk" />
                                    </Grid>

                                    <!-- Batch Rename Input Box -->
                                    <Border Background="#1E1E1E" BorderBrush="#333333" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,0,0,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="80" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="New Name:" VerticalAlignment="Center" Foreground="#AAAAAA" FontSize="11" FontWeight="SemiBold" />
                                            <TextBox Grid.Column="1" Height="24" VerticalContentAlignment="Center"
                                                     Text="{Binding NewName, UpdateSourceTrigger=PropertyChanged}" 
                                                     Background="#141414" Foreground="#FFFFFF" BorderBrush="#444444"
                                                     ToolTip="Target base name to apply when renaming selected group images" />
                                        </Grid>
                                    </Border>

                                    <!-- Group Thumbnail Selection Grid -->
                                    <Border Background="#1A1A1A" BorderBrush="#303030" BorderThickness="1" CornerRadius="4" Padding="6" Margin="0,0,0,10">
                                        <images:Thumbnails x:Name="ThumbControl"
                                                           ItemsSource="{Binding Images}"
                                                           ThumbCellSize="130"
                                                           ThumbHeight="1"
                                                           Selection="{Binding Selection, Mode=OneWay}"
                                                           SenderTag="{Binding GroupId}"
                                                           SelectBox="True"
                                                           ImageClickedCommand="{Binding DataContext.ThumbImageClicked, ElementName=RootWindow}" />
                                    </Border>

                                    <!-- Selected Group Items Actions -->
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Content="🗑️ Delete Selected" 
                                                Margin="0,0,6,0" Height="26" Padding="10,2"
                                                Command="{Binding DeleteSelectedCommand}"
                                                CommandParameter="{Binding ElementName=ThumbControl, Path=Selection}"
                                                ToolTip="Delete only the checked/selected images in this group" />

                                        <Button Content="🏷️ Rename Selected" 
                                                Height="26" Padding="10,2"
                                                Command="{Binding RenameSelectedCommand}"
                                                CommandParameter="{Binding ElementName=ThumbControl, Path=Selection}"
                                                ToolTip="Apply the new filename to checked/selected images" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- 3. Bottom Status & Navigation Bar -->
            <Grid Grid.Row="2" Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Status Panel -->
                <Border Grid.Column="0" Background="#252526" BorderBrush="#383838" BorderThickness="1" Padding="10,6" CornerRadius="6">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="ℹ️ " VerticalAlignment="Center" FontSize="11" />
                        <TextBlock Text="{Binding Status}" Foreground="#CCCCCC" FontSize="11" VerticalAlignment="Center" ToolTip="Comparison status and match counts" />
                    </StackPanel>
                </Border>

                <!-- Group Navigation Controls -->
                <Border Grid.Column="2" Background="#252526" BorderBrush="#383838" BorderThickness="1" Padding="6,4" CornerRadius="6">
                    <StackPanel Orientation="Horizontal">
                        <Button Content="◀ Prev" Command="{Binding PreviousCommand}" Width="75" Height="26" Margin="0,0,6,0" ToolTip="Navigate to previous duplicate set" />
                        <Button Content="Next ▶" Command="{Binding NextCommand}" Width="75" Height="26" ToolTip="Navigate to next duplicate set" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>