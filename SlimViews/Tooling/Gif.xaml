<Window x:Class="SlimViews.Tooling.Gif"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:Gifs="clr-namespace:Imaging.Gifs;assembly=Imaging"
        xmlns:Images="clr-namespace:Common.Images;assembly=Common.Images"
        mc:Ignorable="d"
        Title="GIF Frame Editor" 
        Height="620" Width="980"
        MinHeight="480" MinWidth="800"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Loaded="Window_Loaded"
        Background="#FAFAFA">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/SlimViewer;component/Themes/Generic.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" Padding="6,4">
            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">

                <Button Command="{Binding OpenCommand}" Height="28" Padding="10,2" Margin="2"
                        ToolTip="Open an animated GIF file to edit frames and timing">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📂 " VerticalAlignment="Center" />
                        <TextBlock Text="Open GIF" VerticalAlignment="Center" FontWeight="SemiBold" />
                    </StackPanel>
                </Button>

                <Button Command="{Binding OpenFolderCommand}" Height="28" Padding="10,2" Margin="2"
                        ToolTip="Open a folder of images to compile into a GIF animation">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📁 " VerticalAlignment="Center" />
                        <TextBlock Text="Open Folder" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Rectangle Width="1" Height="20" Fill="#D0D0D0" Margin="6,0" VerticalAlignment="Center" />

                <Button Command="{Binding SaveImagesCommand}" IsEnabled="{Binding IsActive}" Height="28" Padding="10,2" Margin="2"
                        ToolTip="Extract and save all individual frames as separate image files">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🖼️ " VerticalAlignment="Center" />
                        <TextBlock Text="Export Frames" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Rectangle Width="1" Height="20" Fill="#D0D0D0" Margin="6,0" VerticalAlignment="Center" />

                <Button Command="{Binding SaveGifCommand}" IsEnabled="{Binding IsActive}" Height="28" Padding="12,2" Margin="2"
                        FontWeight="Bold" Background="#2E7D32" Foreground="White"
                        ToolTip="Compile frames and save the animated GIF file to disk">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="💾 " VerticalAlignment="Center" />
                        <TextBlock Text="Save GIF" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Rectangle Width="1" Height="20" Fill="#D0D0D0" Margin="6,0" VerticalAlignment="Center" />

                <Button Command="{Binding ClearCommand}" Height="28" Padding="10,2" Margin="2"
                        Foreground="#C62828" ToolTip="Unload current GIF and reset workspace">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="❌ " VerticalAlignment="Center" />
                        <TextBlock Text="Clear All" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

            </WrapPanel>
        </Border>

        <Grid Grid.Row="1" Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="280" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="6" />
                    <RowDefinition Height="140" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="#1E1E1E" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4" ClipToBounds="True">
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                        <Gifs:ImageGif GifSource="{Binding GifPath}"
                                       AutoStart="True"
                                       Stretch="Uniform"
                                       ToolTip="Live animation preview" />
                    </ScrollViewer>
                </Border>

                <GridSplitter Grid.Row="1" Height="6" HorizontalAlignment="Stretch" Background="#E0E0E0" Margin="0,1" ToolTip="Drag to resize thumbnail strip" />

                <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4" Padding="4">
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <Images:Thumbnails Name="Thumb"
                                           ItemsSource="{Binding Observer}"
                                           ThumbCellSize="100"
                                           ThumbHeight="1"
                                           SelectBox="True"
                                           ImageClicked="Thumb_ImageClicked" />
                    </ScrollViewer>
                </Border>
            </Grid>

            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="#E0E0E0" Margin="1,0" ToolTip="Drag to resize controls panel" />

            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>

                    <Border Background="#FFFFFF" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,0,0,10">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <TextBlock Text="⏱️" FontSize="14" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBlock Text="Frame Timing" FontWeight="Bold" FontSize="13" Foreground="#333" VerticalAlignment="Center" />
                            </StackPanel>

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Delay (ms):" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#555" Margin="0,0,10,0" ToolTip="Frame display duration in milliseconds" />
                                <TextBox Grid.Column="1" Height="28" VerticalContentAlignment="Center" TextAlignment="Center"
                                         Text="{Binding CurrentDelay, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Enter duration in milliseconds for the frame (e.g. 100ms = 10 FPS)" />
                            </Grid>

                            <Button Content="💾 Save Current Frame" Height="30" Margin="0,0,0,6" FontWeight="SemiBold"
                                    Command="{Binding SaveCurrentFrameCommand}"
                                    IsEnabled="{Binding IsActive}"
                                    ToolTip="Save the delay setting for the currently selected frame" />

                            <Button Content="⚡ Apply Delay to All" Height="30"
                                    Command="{Binding SetAllDelayCommand}"
                                    IsEnabled="{Binding IsActive}"
                                    ToolTip="Apply this delay value to every frame in the GIF animation" />
                        </StackPanel>
                    </Border>

                    <Border Background="#EBF3FC" BorderBrush="#BCD6F2" BorderThickness="1" CornerRadius="4" Padding="10">
                        <StackPanel>
                            <TextBlock Text="💡 Instructions" FontWeight="SemiBold" Foreground="#005A9E" Margin="0,0,0,4" />
                            <TextBlock Text="• Click thumbnails below to select frames." Foreground="#333" FontSize="11" TextWrapping="Wrap" Margin="0,2" />
                            <TextBlock Text="• Adjust delay (ms) and click Save Frame." Foreground="#333" FontSize="11" TextWrapping="Wrap" Margin="0,2" />
                            <TextBlock Text="• Use 'Save GIF' in toolbar to compile result." Foreground="#333" FontSize="11" TextWrapping="Wrap" Margin="0,2" />
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>
        </Grid>

        <Border Grid.Row="2" Background="#F0F0F0" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0" Padding="8,4">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="ℹ️ " FontSize="11" VerticalAlignment="Center" />
                <TextBlock Text="{Binding Information}" FontSize="11" Foreground="#444" VerticalAlignment="Center" ToolTip="Status and frame count information" />
            </StackPanel>
        </Border>
    </Grid>
</Window>