<Window x:Class="SlimViews.Tooling.TextureConfig"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:images="clr-namespace:Common.Images;assembly=Common.Images"
        xmlns:converters="clr-namespace:Common.Converter;assembly=Common.Converter"
        mc:Ignorable="d"
        WindowStartupLocation="CenterOwner"
        Title="Texture Config" Height="800" Width="450">

    <Window.Resources>
        <ResourceDictionary>
            <converters:ColorToNameConverter x:Key="ColorToNameConverter" />

            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/SlimViewer;component/Themes/Generic.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <Grid Margin="0,0,10,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="160" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" /> <!-- 0  Texture Type -->
                    <RowDefinition Height="Auto" /> <!-- 1  General Settings header -->
                    <RowDefinition Height="Auto" /> <!-- 2  Min Value -->
                    <RowDefinition Height="Auto" /> <!-- 3  Max Value -->
                    <RowDefinition Height="Auto" /> <!-- 4  Alpha -->
                    <RowDefinition Height="Auto" /> <!-- 5  X Period -->
                    <RowDefinition Height="Auto" /> <!-- 6  Y Period -->
                    <RowDefinition Height="Auto" /> <!-- 7  Turbulence Power -->
                    <RowDefinition Height="Auto" /> <!-- 8  Turbulence Size -->
                    <RowDefinition Height="Auto" /> <!-- 9  Base Color -->
                    <RowDefinition Height="Auto" /> <!-- 10 Is Monochrome -->
                    <RowDefinition Height="Auto" /> <!-- 11 Is Tiled -->
                    <RowDefinition Height="Auto" /> <!-- 12 Use Smooth Noise -->
                    <RowDefinition Height="Auto" /> <!-- 13 Use Turbulence -->
                    <RowDefinition Height="Auto" /> <!-- 14 Xy Period -->
                    <RowDefinition Height="Auto" /> <!-- 15 Crosshatch Settings header -->
                    <RowDefinition Height="Auto" /> <!-- 16 Line Spacing -->
                    <RowDefinition Height="Auto" /> <!-- 17 Line Color -->
                    <RowDefinition Height="Auto" /> <!-- 18 Line Thickness -->
                    <RowDefinition Height="Auto" /> <!-- 19 Angle Primary -->
                    <RowDefinition Height="Auto" /> <!-- 20 Angle Secondary -->
                    <RowDefinition Height="Auto" /> <!-- 21 Cellular / Color-Mapped header -->
                    <RowDefinition Height="Auto" /> <!-- 22 Cell Size -->
                    <RowDefinition Height="Auto" /> <!-- 23 Center Color -->
                    <RowDefinition Height="Auto" /> <!-- 24 Edge Color -->
                    <RowDefinition Height="Auto" /> <!-- 25 Color Ramp -->
                    <RowDefinition Height="Auto" /> <!-- 26 Secondary Color -->
                    <RowDefinition Height="Auto" /> <!-- 27 Advanced Texture Settings header -->
                    <RowDefinition Height="Auto" /> <!-- 28 Wave Frequency -->
                    <RowDefinition Height="Auto" /> <!-- 29 Wave Amplitude -->
                    <RowDefinition Height="Auto" /> <!-- 30 Randomization -->
                    <RowDefinition Height="Auto" /> <!-- 31 Edge Jaggedness Limit -->
                    <RowDefinition Height="Auto" /> <!-- 32 Jaggedness Threshold -->
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" FontWeight="Bold" Text="Texture Type" Margin="0,5" />
                <!-- ReSharper disable once Xaml.BindingWithoutContextNotResolved -->
                <ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{Binding TextureOptions}"
                          SelectedItem="{Binding SelectedTexture, UpdateSourceTrigger=PropertyChanged}"
                          ToolTip="Select the pattern algorithm to configure" />

                <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Grid.Column="0" FontWeight="Bold" Text="General Settings"
                           Margin="0,15,0,5" />

                <Label Content="Min Value" Grid.Row="2" Grid.Column="0" />
                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding MinValue, UpdateSourceTrigger=PropertyChanged}"
                         IsEnabled="{Binding IsMinValueActive}" />

                <Label Content="Max Value" Grid.Row="3" Grid.Column="0" />
                <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding MaxValue, UpdateSourceTrigger=PropertyChanged}"
                         IsEnabled="{Binding IsMaxValueActive}" />

                <Label Content="Alpha" Grid.Row="4" Grid.Column="0" />
                <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding Alpha, UpdateSourceTrigger=PropertyChanged}"
                         IsEnabled="{Binding IsAlphaActive}" />

                <Label Content="X Period" Grid.Row="5" Grid.Column="0" />
                <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding XPeriod}" IsEnabled="{Binding IsXPeriodActive}" />

                <Label Content="Y Period" Grid.Row="6" Grid.Column="0" />
                <TextBox Grid.Row="6" Grid.Column="1" Text="{Binding YPeriod}" IsEnabled="{Binding IsYPeriodActive}" />

                <Label Content="Turbulence Power" Grid.Row="7" Grid.Column="0" />
                <TextBox Grid.Row="7" Grid.Column="1" Text="{Binding TurbulencePower}"
                         IsEnabled="{Binding IsTurbulencePowerActive}" />

                <Label Content="Turbulence Size" Grid.Row="8" Grid.Column="0" />
                <TextBox Grid.Row="8" Grid.Column="1" Text="{Binding TurbulenceSize}"
                         IsEnabled="{Binding IsTurbulenceSizeActive}" />

                <Label Content="Base Color" Grid.Row="9" Grid.Column="0" />
                <images:ColorSelection Grid.Row="9" Grid.Column="1"
                                       StartColor="{Binding BaseColor, Converter={StaticResource ColorToNameConverter}, Mode=TwoWay}"
                                       IsEnabled="{Binding IsBaseColorActive}" />

                <Label Content="Is Monochrome" Grid.Row="10" Grid.Column="0" />
                <CheckBox Grid.Row="10" Grid.Column="1" IsChecked="{Binding IsMonochrome}"
                          IsEnabled="{Binding IsMonochromeActive}" VerticalAlignment="Center" />

                <Label Content="Is Tiled" Grid.Row="11" Grid.Column="0" />
                <CheckBox Grid.Row="11" Grid.Column="1" IsChecked="{Binding IsTiled}"
                          IsEnabled="{Binding IsTiledActive}" VerticalAlignment="Center" />

                <Label Content="Use Smooth Noise" Grid.Row="12" Grid.Column="0" />
                <CheckBox Grid.Row="12" Grid.Column="1" IsChecked="{Binding UseSmoothNoise}"
                          IsEnabled="{Binding IsUseSmoothNoiseActive}" VerticalAlignment="Center" />

                <Label Content="Use Turbulence" Grid.Row="13" Grid.Column="0" />
                <CheckBox Grid.Row="13" Grid.Column="1" IsChecked="{Binding UseTurbulence}"
                          IsEnabled="{Binding IsUseTurbulenceActive}" VerticalAlignment="Center" />

                <Label Content="Xy Period" Grid.Row="14" Grid.Column="0" />
                <TextBox Grid.Row="14" Grid.Column="1" Text="{Binding XyPeriod}"
                         IsEnabled="{Binding IsXyPeriodActive}" />

                <TextBlock Grid.Row="15" Grid.ColumnSpan="2" Grid.Column="0" FontWeight="Bold"
                           Text="Crosshatch Settings"
                           Margin="0,15,0,5" />

                <Label Content="Line Spacing" Grid.Row="16" Grid.Column="0" />
                <TextBox Grid.Row="16" Grid.Column="1" Text="{Binding LineSpacing}"
                         IsEnabled="{Binding IsLineSpacingActive}" />

                <Label Content="Line Color" Grid.Row="17" Grid.Column="0" />
                <images:ColorSelection Grid.Row="17" Grid.Column="1"
                                       StartColor="{Binding LineColor, Converter={StaticResource ColorToNameConverter}, Mode=TwoWay}"
                                       IsEnabled="{Binding IsLineColorActive}" />

                <Label Content="Line Thickness" Grid.Row="18" Grid.Column="0" />
                <TextBox Grid.Row="18" Grid.Column="1" Text="{Binding LineThickness}"
                         IsEnabled="{Binding IsLineThicknessActive}" />

                <Label Content="Angle Primary" Grid.Row="19" Grid.Column="0" />
                <TextBox Grid.Row="19" Grid.Column="1" Text="{Binding AnglePrimary}"
                         IsEnabled="{Binding IsAnglePrimaryActive}" />

                <Label Content="Angle Secondary" Grid.Row="20" Grid.Column="0" />
                <TextBox Grid.Row="20" Grid.Column="1" Text="{Binding AngleSecondary}"
                         IsEnabled="{Binding IsAngleSecondaryActive}" />

                <TextBlock Grid.Row="21" Grid.ColumnSpan="2" Grid.Column="0" FontWeight="Bold"
                           Text="Cellular / Color-Mapped Settings"
                           Margin="0,15,0,5" />

                <Label Content="Cell Size" Grid.Row="22" Grid.Column="0" />
                <TextBox Grid.Row="22" Grid.Column="1" Text="{Binding CellSize, UpdateSourceTrigger=PropertyChanged}"
                         IsEnabled="{Binding IsCellSizeActive}" />

                <Label Content="Center Color" Grid.Row="23" Grid.Column="0" />
                <images:ColorSelection Grid.Row="23" Grid.Column="1"
                                       StartColor="{Binding CenterColor, Converter={StaticResource ColorToNameConverter}, Mode=TwoWay}"
                                       IsEnabled="{Binding IsCenterColorActive}" />

                <Label Content="Edge Color" Grid.Row="24" Grid.Column="0" />
                <images:ColorSelection Grid.Row="24" Grid.Column="1"
                                       StartColor="{Binding EdgeColor, Converter={StaticResource ColorToNameConverter}, Mode=TwoWay}"
                                       IsEnabled="{Binding IsEdgeColorActive}" />

                <Label Content="Color Ramp" Grid.Row="25" Grid.Column="0" />
                <TextBox Grid.Row="25" Grid.Column="1"
                         Text="{Binding ColorRampText, UpdateSourceTrigger=PropertyChanged}"
                         IsEnabled="{Binding IsColorRampActive}"
                         ToolTip="Comma-separated #AARRGGBB colors, e.g. #FFFF4400, #FFFFCC00" />

                <Label Content="Secondary Color" Grid.Row="26" Grid.Column="0" />
                <images:ColorSelection Grid.Row="26" Grid.Column="1"
                                       StartColor="{Binding SecondaryColor, Converter={StaticResource ColorToNameConverter}, Mode=TwoWay}"
                                       IsEnabled="{Binding IsSecondaryColorActive}"
                                       ToolTip="Not yet read by generation for any texture type - see the property's XML doc remarks" />

                <TextBlock Grid.Row="27" Grid.ColumnSpan="2" Grid.Column="0" FontWeight="Bold"
                           Text="Advanced Texture Settings"
                           Margin="0,15,0,5" />

                <Label Content="Wave Frequency" Grid.Row="28" Grid.Column="0" />
                <TextBox Grid.Row="28" Grid.Column="1" Text="{Binding WaveFrequency}"
                         IsEnabled="{Binding IsWaveFrequencyActive}" />

                <Label Content="Wave Amplitude" Grid.Row="29" Grid.Column="0" />
                <TextBox Grid.Row="29" Grid.Column="1" Text="{Binding WaveAmplitude}"
                         IsEnabled="{Binding IsWaveAmplitudeActive}" />

                <Label Content="Randomization" Grid.Row="30" Grid.Column="0" />
                <TextBox Grid.Row="30" Grid.Column="1" Text="{Binding RandomizationFactor}"
                         IsEnabled="{Binding IsRandomizationFactorActive}" />

                <Label Content="Edge Jaggedness Limit" Grid.Row="31" Grid.Column="0" />
                <TextBox Grid.Row="31" Grid.Column="1" Text="{Binding EdgeJaggednessLimit}"
                         IsEnabled="{Binding IsEdgeJaggednessLimitActive}" />

                <Label Content="Jaggedness Threshold" Grid.Row="32" Grid.Column="0" />
                <TextBox Grid.Row="32" Grid.Column="1" Text="{Binding JaggednessThreshold}"
                         IsEnabled="{Binding IsJaggednessThresholdActive}" />
            </Grid>
        </ScrollViewer>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Save" Width="80" Margin="5" Command="{Binding SaveCommand}" />
            <Button Content="Reset" Width="80" Margin="5" Command="{Binding ResetCommand}" />
            <Button Content="Cancel" Width="80" Margin="5"
                    Command="{Binding CancelCommand}"
                    CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}" />
        </StackPanel>
    </Grid>
</Window>