<Window x:Class="SlimViews.HelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SlimViewer - Help" 
        Height="540" Width="580"
        MinHeight="460" MinWidth="500"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="#FAFAFA">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/SlimViewer;component/Themes/Generic.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="*" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header Title Card -->
        <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4" Padding="14,12">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="📖" FontSize="20" VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBlock Text="SlimViewer Documentation" FontSize="18" FontWeight="Bold" Foreground="#222222" VerticalAlignment="Center" />
            </StackPanel>
        </Border>

        <!-- Main Documentation Scroll Viewer -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,0,6,0">

                <!-- 1. Overview Card -->
                <Border Background="#FFFFFF" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,0,0,12">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Text="💡" FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBlock Text="Overview" FontSize="14" FontWeight="SemiBold" Foreground="#005A9E" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="SlimViewer is a fast, lightweight image viewer and editor. Use the top menu or the keyboard shortcuts below to navigate, edit, and manage your images without taking your hands off the keyboard."
                                   TextWrapping="Wrap" Foreground="#444444" LineHeight="18" FontSize="12" />
                    </StackPanel>
                </Border>

                <!-- 2. Keyboard Shortcuts Card -->
                <Border Background="#FFFFFF" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4" Padding="12">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Text="⌨️" FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBlock Text="Global Keyboard Shortcuts" FontSize="14" FontWeight="SemiBold" Foreground="#005A9E" VerticalAlignment="Center" />
                        </StackPanel>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="6" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="6" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="6" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="6" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="6" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="6" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="6" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="6" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Left Arrow -->
                            <Border Grid.Row="0" Grid.Column="0" Background="#F2F2F2" BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="3" Padding="6,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                <TextBlock Text="◀ Left Arrow" FontFamily="Consolas" FontWeight="Bold" FontSize="11" Foreground="#333" />
                            </Border>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="Previous Image" VerticalAlignment="Center" Foreground="#444" FontSize="12" />

                            <!-- Right Arrow -->
                            <Border Grid.Row="2" Grid.Column="0" Background="#F2F2F2" BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="3" Padding="6,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                <TextBlock Text="▶ Right Arrow" FontFamily="Consolas" FontWeight="Bold" FontSize="11" Foreground="#333" />
                            </Border>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="Next Image" VerticalAlignment="Center" Foreground="#444" FontSize="12" />

                            <!-- Delete -->
                            <Border Grid.Row="4" Grid.Column="0" Background="#F2F2F2" BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="3" Padding="6,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                <TextBlock Text="Delete" FontFamily="Consolas" FontWeight="Bold" FontSize="11" Foreground="#333" />
                            </Border>
                            <TextBlock Grid.Row="4" Grid.Column="1" Text="Delete current image from disk" VerticalAlignment="Center" Foreground="#444" FontSize="12" />

                            <!-- F5 -->
                            <Border Grid.Row="6" Grid.Column="0" Background="#F2F2F2" BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="3" Padding="6,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                <TextBlock Text="F5" FontFamily="Consolas" FontWeight="Bold" FontSize="11" Foreground="#333" />
                            </Border>
                            <TextBlock Grid.Row="6" Grid.Column="1" Text="Refresh current image" VerticalAlignment="Center" Foreground="#444" FontSize="12" />

                            <!-- Ctrl + O -->
                            <Border Grid.Row="8" Grid.Column="0" Background="#F2F2F2" BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="3" Padding="6,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                <TextBlock Text="Ctrl + O" FontFamily="Consolas" FontWeight="Bold" FontSize="11" Foreground="#333" />
                            </Border>
                            <TextBlock Grid.Row="8" Grid.Column="1" Text="Open Image file dialog" VerticalAlignment="Center" Foreground="#444" FontSize="12" />

                            <!-- Ctrl + S -->
                            <Border Grid.Row="10" Grid.Column="0" Background="#F2F2F2" BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="3" Padding="6,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                <TextBlock Text="Ctrl + S" FontFamily="Consolas" FontWeight="Bold" FontSize="11" Foreground="#333" />
                            </Border>
                            <TextBlock Grid.Row="10" Grid.Column="1" Text="Save current image edits" VerticalAlignment="Center" Foreground="#444" FontSize="12" />

                            <!-- Ctrl + Z -->
                            <Border Grid.Row="12" Grid.Column="0" Background="#F2F2F2" BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="3" Padding="6,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                <TextBlock Text="Ctrl + Z" FontFamily="Consolas" FontWeight="Bold" FontSize="11" Foreground="#333" />
                            </Border>
                            <TextBlock Grid.Row="12" Grid.Column="1" Text="Undo last edit operation" VerticalAlignment="Center" Foreground="#444" FontSize="12" />

                            <!-- Ctrl + Y -->
                            <Border Grid.Row="14" Grid.Column="0" Background="#F2F2F2" BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="3" Padding="6,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                <TextBlock Text="Ctrl + Y" FontFamily="Consolas" FontWeight="Bold" FontSize="11" Foreground="#333" />
                            </Border>
                            <TextBlock Grid.Row="14" Grid.Column="1" Text="Redo last undone operation" VerticalAlignment="Center" Foreground="#444" FontSize="12" />

                            <!-- Ctrl + C -->
                            <Border Grid.Row="16" Grid.Column="0" Background="#F2F2F2" BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="3" Padding="6,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                <TextBlock Text="Ctrl + C" FontFamily="Consolas" FontWeight="Bold" FontSize="11" Foreground="#333" />
                            </Border>
                            <TextBlock Grid.Row="16" Grid.Column="1" Text="Copy current image to Windows clipboard" VerticalAlignment="Center" Foreground="#444" FontSize="12" />
                        </Grid>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- Footer Action Button -->
        <Button Grid.Row="4" Content="❌ Close" Width="100" Height="30" HorizontalAlignment="Right"
                FontWeight="SemiBold" IsCancel="True" Click="Button_Click"
                ToolTip="Close help window" />
    </Grid>
</Window>